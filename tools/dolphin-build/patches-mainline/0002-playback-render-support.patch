+extern std::unique_ptr<SlippiPlaybackStatus> g_playback_status;
+extern std::unique_ptr<SlippiReplayComm> g_replay_comm;
+
+// When dumping frames, only record the replay itself: not menus or the waiting screen, not
+// fast-forwarded frames, and only strictly between the comm file's startFrame and endFrame
+// (the same rule Ishiiruka's playback build used).
+static bool IsPlaybackFrameDumpable()
+{
+  if (!g_playback_status || !g_replay_comm || !g_playback_status->in_slippi_playback)
+    return false;
+  if (g_playback_status->is_hard_FFW || g_playback_status->is_soft_FFW)
+    return false;
+  const s32 frame = g_playback_status->current_playback_frame;
+  return g_replay_comm->current.start_frame < frame && frame < g_replay_comm->current.end_frame;
+}
+#endif
